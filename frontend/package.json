{
  "name": "argus-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api-types": "openapi-typescript openapi.json --default-non-nullable false -o src/lib/api/schema.gen.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "hls.js": "^1.7.3",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
