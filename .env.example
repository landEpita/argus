# Copy to .env. Every variable is optional; Argus starts with no keys at all.

# ── Backend (prefix ARGUS_) ──────────────────────────────────────────────────
ARGUS_LOG_LEVEL=INFO
# One JSON object per log line (on by default in the Docker image)
ARGUS_LOG_JSON=false
ARGUS_HTTP_TIMEOUT_S=10
ARGUS_OPENSKY_ENABLED=true
ARGUS_AIRCRAFT_CACHE_TTL_S=15
# Local dev defaults to a SQLite file; docker-compose overrides both of these.
# ARGUS_DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
# ARGUS_REDIS_URL=redis://localhost:6379/0
# ── Optional keys: each one switches on a layer or raises a quota ────────────
# OpenSky OAuth API client (free account): 4,000 credits/day instead of 400 anonymous
# ARGUS_OPENSKY_CLIENT_ID=
# ARGUS_OPENSKY_CLIENT_SECRET=
# Launch Library 2 token: raises the 15 requests/hour anonymous limit
# ARGUS_LAUNCHLIBRARY_TOKEN=
# NASA FIRMS fire hotspots — free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# ARGUS_FIRMS_MAP_KEY=
# AIS ships — free key: https://aisstream.io  (the key never leaves the server)
# ARGUS_AISSTREAM_API_KEY=
# Limit AIS to some areas to save bandwidth: [[[south, west], [north, east]], …]
# ARGUS_AISSTREAM_BOUNDING_BOXES=[[[30, -10], [46, 37]]]

# Every keyless source can be switched off individually:
# ARGUS_OPENSKY_ENABLED / ARGUS_ADSBLOL_ENABLED / ARGUS_USGS_ENABLED / ARGUS_EONET_ENABLED
# ARGUS_GDACS_ENABLED / ARGUS_GDELT_ENABLED / ARGUS_CELESTRAK_ENABLED
# ARGUS_UKRAINE_ALERTS_ENABLED / ARGUS_LAUNCHLIBRARY_ENABLED / ARGUS_OVERPASS_ENABLED
# ARGUS_TELEGEOGRAPHY_ENABLED / ARGUS_RAINVIEWER_ENABLED
# Finance: ARGUS_YAHOO_ENABLED / ARGUS_COINGECKO_ENABLED / ARGUS_FUNDING_ENABLED
# ARGUS_POLYMARKET_ENABLED / ARGUS_MACRO_ENABLED / ARGUS_PORTWATCH_ENABLED
# ARGUS_LIQUIDATIONS_ENABLED / ARGUS_EIA_ENABLED
# US energy inventories — free key: https://www.eia.gov/opendata/register.php
# (unset = DEMO_KEY, limited to a few calls per hour)
# ARGUS_EIA_API_KEY=

# OpenBB as the first quote provider (needs `uv sync --extra openbb`, heavy install)
# ARGUS_OPENBB_ENABLED=false

# JSON list; only needed when the browser calls the API directly (not via the Next proxy)
ARGUS_CORS_ORIGINS=["http://localhost:3000"]

# ── Assistant (LiteLLM: any model) ───────────────────────────────────────────
# Defaults only: a model chosen in the app (Sources → Assistant model) wins.
# ARGUS_LLM_MODEL=ollama/mistral
# ARGUS_LLM_API_BASE=http://host.docker.internal:11434
# ARGUS_LLM_MODEL=anthropic/claude-sonnet-5
# ARGUS_LLM_API_KEY=
# Tried in order if the main model fails; each uses its provider's usual variable:
# ARGUS_LLM_FALLBACK_MODELS=["anthropic/claude-haiku-4-5-20251001"]
# ANTHROPIC_API_KEY=
# Semantic search (same key and base URL): e.g. ollama/nomic-embed-text
# ARGUS_EMBEDDING_MODEL=
# ARGUS_ASSISTANT_ENABLED=true
# Read-only MCP server at /mcp for Claude Desktop / Claude Code
# ARGUS_MCP_ENABLED=true

# ── docker-compose ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=argus

# ── Frontend (build time): where Next proxies /api to ────────────────────────
BACKEND_URL=http://localhost:8000
